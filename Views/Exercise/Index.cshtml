@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GymBuddy — Exercise Library</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,300&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    /* ══ PALETTE ════════════════════════════════════════════════
       0B0DF4 Void Black  ·  3DF2E0 Neon Cyan
    ═══════════════════════════════════════════════════════════ */
    :root {
      --bg:        #0d0f14;
      --surf:      #131720;
      --card:      #191e28;
      --card2:     #1f2535;
      --border:    #252d40;
      --border2:   #2e3a52;
      --muted:     #3a5070;
      --dim:       #5a7a9a;
      --text:      #8ab0cc;
      --light:     #c0ddf0;
      --white:     #eaf6ff;

      --gray1:     #B2B9C1;
      --gray2:     #D8DCDF;

      --cyan:      #3DF2E0;
      --cyan2:     #2dd4c4;
      --cyan3:     #1ab8a8;
      --cg:        rgba(61,242,224,.10);
      --cg2:       rgba(61,242,224,.18);
      --cg3:       rgba(61,242,224,.32);

      /* Keep orange vars aliased to cyan so all existing references work */
      --orange:    #3DF2E0;
      --orange2:   #2dd4c4;
      --orange3:   #1ab8a8;
      --og:        rgba(61,242,224,.08);
      --og2:       rgba(61,242,224,.15);
      --og3:       rgba(61,242,224,.28);

      --r:         10px;
      --r2:        16px;
      --display:   'Bebas Neue',sans-serif;
      --body:      'DM Sans',sans-serif;
      --mono:      'DM Mono',monospace;
    }

    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{background:var(--bg);color:var(--text);font-family:var(--body);font-size:14px;line-height:1.6;min-height:100vh;overflow-x:hidden}
    ::-webkit-scrollbar{width:5px}
    ::-webkit-scrollbar-track{background:var(--bg)}
    ::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}
    ::-webkit-scrollbar-thumb:hover{background:var(--cyan)}
    button{font-family:var(--body)}

    /* ══ PAGE SYSTEM ════════════════════════════════════════════ */
    #introPage{display:flex;flex-direction:column;min-height:100vh}
    #appPage{display:none;flex-direction:column}
    #appPage.active{display:flex}

    /* ════════════════════════════════════════════════════════════
       INTRO PAGE
    ═════════════════════════════════════════════════════════════ */

    /* Fixed nav */
    .intro-topbar{
      position:fixed;top:0;left:0;right:0;z-index:100;
      display:flex;align-items:center;justify-content:space-between;
      padding:0 56px;height:60px;
      background:rgba(13,15,20,.92);
      backdrop-filter:blur(16px);
      border-bottom:1px solid var(--border);
    }
    .intro-logo{
      font-family:var(--display);font-size:22px;letter-spacing:2px;
      color:var(--light);display:flex;align-items:center;gap:9px;
    }
    .intro-logo-pip{width:9px;height:9px;border-radius:50%;background:var(--orange)}
    .intro-logo em{color:var(--orange);font-style:normal}
    .nav-link{
      font-family:var(--mono);font-size:11px;letter-spacing:1.5px;text-transform:uppercase;
      color:var(--dim);background:none;
      border:1px solid var(--border2);border-radius:var(--r);
      padding:7px 16px;cursor:pointer;transition:all .15s;
    }
    .nav-link:hover{border-color:var(--orange);color:var(--orange);background:var(--og)}

    /* Hero — compact split */
    .intro-hero{
      margin-top:60px;
      display:grid;
      grid-template-columns:1fr 340px;
      height:calc(100vh - 60px);
      max-height:calc(100vh - 60px);
      overflow:hidden;
    }

    /* Left text panel — content pinned to bottom via absolute */
    .intro-left{
      position:relative;
      background:var(--surf);
      border-right:1px solid var(--border);
      overflow:hidden;
    }
    .intro-left-content{
      position:absolute;
      bottom:0;left:0;right:0;
      padding:0 52px 32px;
    }
    .intro-eyebrow{
      font-family:var(--mono);font-size:10px;letter-spacing:3px;text-transform:uppercase;
      color:var(--orange);display:flex;align-items:center;gap:10px;margin-bottom:10px;
    }
    .intro-eyebrow::before{content:'';width:24px;height:1px;background:var(--orange)}
    .intro-h1{
      font-family:var(--display);
      font-size:clamp(36px,4.2vw,58px);
      letter-spacing:2px;line-height:.92;
      color:var(--light);margin-bottom:14px;
    }
    .intro-h1 em{color:var(--orange);font-style:normal;display:block}
    .intro-sub{
      font-size:13px;color:var(--dim);line-height:1.6;
      max-width:440px;margin-bottom:18px;font-weight:300;
    }
    .intro-sub strong{color:var(--text);font-weight:500}

    /* Stats */
    .intro-stats{display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap}
    .istat{display:flex;flex-direction:column;gap:1px;padding:10px 14px;background:var(--card2);border:1px solid var(--border);border-radius:var(--r);min-width:80px}
    .istat-num{font-family:var(--display);font-size:24px;letter-spacing:1px;color:var(--light);line-height:1}
    .istat-num span{color:var(--orange)}
    .istat-label{font-family:var(--mono);font-size:8.5px;letter-spacing:2px;text-transform:uppercase;color:var(--muted)}

    /* CTA */
    .cta-btn{
      display:inline-flex;align-items:center;gap:10px;
      background:var(--orange);color:#fff;
      font-family:var(--display);font-size:16px;letter-spacing:1.5px;text-transform:uppercase;
      padding:12px 24px;border-radius:var(--r);border:none;cursor:pointer;
      transition:all .22s;box-shadow:0 4px 18px var(--og3);width:fit-content;
    }
    .cta-btn:hover{background:var(--orange2);transform:translateY(-2px);box-shadow:0 8px 24px var(--og3)}
    .cta-btn svg{width:16px;height:16px;transition:transform .2s}
    .cta-btn:hover svg{transform:translateX(4px)}
    .intro-note{margin-top:10px;font-size:11px;color:var(--muted);display:flex;align-items:center;gap:6px}
    .intro-note svg{width:12px;height:12px;color:var(--orange)}

    /* Right photo column — single centered column mosaic */
    .intro-right{
      position:relative;overflow:hidden;
      display:grid;
      grid-template-columns:1fr;
      grid-template-rows:repeat(3,1fr);
      gap:3px;
      background:var(--card);
      margin-left:-120px;
    }
    .intro-right::before{
      content:'';position:absolute;inset:0;z-index:2;pointer-events:none;
      background:
        linear-gradient(to right, var(--surf) 0%, rgba(19,23,32,.85) 18%, transparent 42%),
        linear-gradient(to bottom, var(--bg) 0%, transparent 18%, transparent 82%, var(--bg) 100%);
    }
    .mosaic-img{overflow:hidden;position:relative}
    .mosaic-img img{
      width:100%;height:100%;object-fit:cover;
      filter:grayscale(20%) brightness(.82) saturate(.9);
      animation:kb 14s ease-in-out infinite alternate;
    }
    .mosaic-img:nth-child(2) img{animation-delay:-4s}
    .mosaic-img:nth-child(3) img{animation-delay:-8s}
    @@keyframes kb{from{transform:scale(1)}to{transform:scale(1.08) translate(-1%,-1%)}}

    /* Feature strip */
    .intro-features{
      background:var(--surf);
      border-top:1px solid var(--border);
      display:grid;grid-template-columns:repeat(4,1fr);
    }
    .feat{
      padding:30px 36px;border-right:1px solid var(--border);
      display:flex;flex-direction:column;gap:10px;
    }
    .feat:last-child{border-right:none}
    .feat-icon{
      width:40px;height:40px;border-radius:9px;
      background:var(--og);border:1px solid rgba(255,114,0,.2);
      display:flex;align-items:center;justify-content:center;color:var(--orange);
    }
    .feat-icon svg{width:20px;height:20px}
    .feat-title{font-family:var(--display);font-size:18px;letter-spacing:.5px;color:var(--light)}
    .feat-desc{font-size:12.5px;color:var(--muted);line-height:1.6}

    /* ════════════════════════════════════════════════════════════
       APP PAGE
    ═════════════════════════════════════════════════════════════ */

    .app-shell{
      display:grid;
      grid-template-columns:256px 1fr;
      grid-template-rows:60px 1fr;
      height:100vh;
      overflow:hidden;
    }

    /* App topbar */
    .app-topbar{
      grid-column:1/-1;
      display:flex;align-items:center;gap:16px;
      padding:0 22px;
      background:rgba(13,15,20,.95);
      backdrop-filter:blur(16px);
      border-bottom:1px solid var(--border);
      position:sticky;top:0;z-index:200;
    }
    .back-btn{
      display:flex;align-items:center;gap:5px;
      background:none;border:1px solid var(--border);color:var(--muted);
      border-radius:var(--r);padding:6px 13px;font-size:12px;cursor:pointer;
      transition:all .15s;font-family:var(--mono);letter-spacing:.5px;
    }
    .back-btn:hover{border-color:var(--orange);color:var(--orange)}
    .back-btn svg{width:13px;height:13px}
    .app-logo{font-family:var(--display);font-size:20px;letter-spacing:2px;color:var(--light)}
    .app-logo em{color:var(--orange);font-style:normal}
    .search-wrap{flex:1;max-width:380px;position:relative;min-width:0}
    .search-wrap input{
      width:100%;background:var(--card2);border:1px solid var(--border);
      border-radius:999px;padding:8px 34px 8px 38px;
      color:var(--text);font-family:var(--body);font-size:13.5px;outline:none;
      transition:border-color .2s,box-shadow .2s;
    }
    .search-wrap input::placeholder{color:var(--muted)}
    .search-wrap input:focus{border-color:var(--orange);box-shadow:0 0 0 3px var(--og)}
    .s-ico{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted);pointer-events:none}
    .s-clr{position:absolute;right:11px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--muted);cursor:pointer;font-size:17px;display:none;line-height:1}
    .search-wrap input:not(:placeholder-shown)~.s-clr{display:block}
    .app-end{margin-left:auto}
    .cnt-badge{font-family:var(--mono);font-size:12px;color:var(--muted);background:var(--card2);border:1px solid var(--border);border-radius:999px;padding:4px 13px}
    .cnt-badge strong{color:var(--orange)}

    /* Sidebar */
    .sidebar{
      background:var(--surf);border-right:1px solid var(--border);
      overflow-y:auto;padding:18px 0;
    }
    .sb-label{
      font-family:var(--mono);font-size:9.5px;letter-spacing:2.5px;
      text-transform:uppercase;color:var(--muted);padding:0 16px 9px;
    }
    .nav-item{
      display:flex;align-items:center;gap:11px;
      padding:8px 16px;cursor:pointer;
      border-left:2px solid transparent;
      transition:background .14s,border-color .14s;
    }
    .nav-item:hover{background:var(--og)}
    .nav-item.active{background:var(--og);border-left-color:var(--orange)}
    .nav-thumb{
      width:38px;height:38px;border-radius:8px;overflow:hidden;
      flex-shrink:0;border:1px solid var(--border);
      background:var(--card2);
      display:flex;align-items:center;justify-content:center;
      transition:border-color .14s,background .14s;
    }
    .nav-thumb svg{width:22px;height:22px;color:var(--muted);transition:color .14s}
    .nav-item:hover .nav-thumb{border-color:var(--border2);background:var(--og)}
    .nav-item:hover .nav-thumb svg{color:var(--orange)}
    .nav-item.active .nav-thumb{border-color:var(--orange);background:var(--og)}
    .nav-item.active .nav-thumb svg{color:var(--orange)}
    .nav-info{flex:1;min-width:0}
    .nav-name{font-size:13px;font-weight:500;color:var(--text);display:block;line-height:1.2}
    .nav-sub{font-size:11px;color:var(--muted);display:block;margin-top:1px}
    .nav-item.active .nav-name{color:var(--orange)}
    .sb-rule{height:1px;background:var(--border);margin:14px 16px}

    /* Difficulty dot colors — used by diff-bar */
    .dd{width:7px;height:7px;border-radius:50%;flex-shrink:0}
    .dd.a{background:var(--border2)}.dd.b{background:#22c55e}.dd.i{background:var(--cyan2)}

    /* Difficulty — inline bar (always visible) */
    .diff-bar{
      display:flex;
      align-items:center;gap:7px;
      padding:8px 16px;
      border-bottom:1px solid var(--border);
      background:var(--bg);
      overflow-x:auto;scrollbar-width:none;
      flex-shrink:0;
    }
    .diff-bar::-webkit-scrollbar{display:none}
    .diff-bar-lbl{font-family:var(--mono);font-size:9.5px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);white-space:nowrap;flex-shrink:0}
    .diff-bar-btn{
      display:flex;align-items:center;gap:6px;
      padding:4px 12px;border-radius:999px;
      border:1px solid var(--border);background:none;
      color:var(--dim);font-size:12px;font-family:var(--body);
      cursor:pointer;transition:all .14s;white-space:nowrap;flex-shrink:0;
    }
    .diff-bar-btn:hover{border-color:var(--border2);color:var(--text)}
    .diff-bar-btn.active{background:var(--cyan);border-color:var(--cyan);color:var(--bg);font-weight:600}
    .diff-bar-btn .dd{flex-shrink:0}

    /* Main panel */
    .main-panel{overflow-y:auto;display:flex;flex-direction:column;background:var(--bg)}

    /* Hero header with photo */
    .main-hero{position:relative;border-bottom:1px solid var(--border);flex-shrink:0;background:var(--bg)}
    .hero-img-strip{height:160px;position:relative;overflow:hidden}
    .hero-img-strip img{width:100%;height:100%;object-fit:cover;filter:brightness(.45) saturate(.6)}
    .hero-img-strip::after{
      content:'';position:absolute;inset:0;
      background:linear-gradient(to bottom,transparent 30%,var(--bg) 100%);
    }
    /* Text sits BELOW the image, not overlaid */
    .hero-content{
      padding:14px 32px 18px;
      background:var(--bg);
    }
    .hero-eyebrow{
      font-family:var(--mono);font-size:10px;letter-spacing:2.5px;text-transform:uppercase;
      color:var(--cyan);margin-bottom:6px;display:flex;align-items:center;gap:8px;
    }
    .hero-eyebrow::before{content:'';width:18px;height:1px;background:var(--cyan)}
    .hero-title{
      font-family:var(--display);font-size:clamp(28px,4vw,48px);
      letter-spacing:2px;color:var(--white);line-height:1;margin-bottom:5px;
    }
    .hero-title em{color:var(--cyan);font-style:normal}
    .hero-meta{font-size:12px;color:var(--dim)}

    /* Type chips */
    .chip-row{
      display:flex;align-items:center;gap:7px;
      padding:10px 32px;border-bottom:1px solid var(--border);
      background:var(--surf);overflow-x:auto;scrollbar-width:none;
    }
    .chip-row::-webkit-scrollbar{display:none}
    .chip-row-lbl{font-family:var(--mono);font-size:9.5px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);white-space:nowrap;flex-shrink:0}
    .chip{
      padding:4px 13px;border-radius:999px;border:1px solid var(--border);
      background:none;color:var(--muted);font-size:12px;cursor:pointer;
      transition:all .14s;white-space:nowrap;flex-shrink:0;text-transform:capitalize;
    }
    .chip:hover{border-color:var(--orange);color:var(--orange);background:var(--og)}
    .chip.active{background:var(--orange);border-color:var(--orange);color:#fff;font-weight:600}

    /* Content */
    .content{padding:24px 32px;flex:1}
    .ex-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px}

    /* Card */
    .ex-card{
      background:var(--card);border:1px solid var(--border);
      border-radius:var(--r2);overflow:hidden;cursor:pointer;
      display:flex;flex-direction:column;
      transition:border-color .2s,box-shadow .2s,transform .2s;
      animation:riseIn .38s cubic-bezier(.22,.68,0,1.2) both;
    }
    .ex-card:hover{
      border-color:var(--orange);
      box-shadow:0 8px 28px rgba(255,114,0,.14),0 0 0 1px var(--orange);
      transform:translateY(-3px);
    }
    @@keyframes riseIn{from{opacity:0;transform:translateY(16px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}

    .card-img-wrap{height:180px;position:relative;overflow:hidden;background:var(--card2);flex-shrink:0}
    .card-img-wrap img{
      width:100%;height:100%;object-fit:cover;
      filter:grayscale(20%) brightness(.9) saturate(.85);
      transition:filter .3s,transform .4s;
    }
    .ex-card:hover .card-img-wrap img{filter:grayscale(0%) brightness(.95) saturate(1);transform:scale(1.05)}
    .card-img-wrap::after{
      content:'';position:absolute;bottom:0;left:0;right:0;height:70px;
      background:linear-gradient(to top,var(--card) 0%,transparent 100%);
      pointer-events:none;
    }

    /* Orange top accent line */
    .card-accent{height:3px;background:linear-gradient(90deg,var(--cyan) 0%,var(--cyan3) 100%);flex-shrink:0}

    .diff-badge{
      position:absolute;top:10px;left:10px;z-index:2;
      font-family:var(--mono);font-size:9.5px;letter-spacing:1.5px;text-transform:uppercase;
      padding:3px 9px;border-radius:999px;border:1px solid;backdrop-filter:blur(6px);
    }
    .diff-badge.beginner{color:#22c55e;border-color:#22c55e;background:rgba(34,197,94,.12)}
    .diff-badge.intermediate{color:var(--cyan);border-color:var(--cyan);background:rgba(61,242,224,.12)}
    .diff-badge.expert{color:#ef4444;border-color:#ef4444;background:rgba(239,68,68,.12)}
    .type-badge{
      position:absolute;top:10px;right:10px;z-index:2;
      font-size:9.5px;color:var(--dim);
      background:rgba(13,15,20,.82);border:1px solid var(--border);
      border-radius:999px;padding:3px 9px;text-transform:capitalize;letter-spacing:.5px;
    }

    .card-body{padding:13px 16px 15px;flex:1;display:flex;flex-direction:column;gap:7px}
    .card-name{font-family:var(--display);font-size:19px;letter-spacing:.8px;color:var(--light);line-height:1.1;text-transform:capitalize}
    .card-muscle{display:flex;align-items:center;gap:5px}
    .muscle-pip{width:5px;height:5px;border-radius:50%;background:var(--orange);flex-shrink:0}
    .card-muscle span{font-size:11.5px;color:var(--orange);font-weight:500;text-transform:capitalize}
    .card-desc{font-size:12.5px;color:var(--muted);line-height:1.55;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;flex:1}

    .card-foot{
      display:flex;align-items:center;justify-content:space-between;
      padding:10px 16px;border-top:1px solid var(--border);
      background:var(--card2);
    }
    .card-equip svg{width:12px;height:12px;opacity:.5}
    .view-btn{
      display:flex;align-items:center;gap:4px;
      background:none;border:1px solid var(--border);color:var(--muted);
      border-radius:var(--r);padding:5px 11px;font-size:12px;cursor:pointer;
      transition:all .14s;
    }
    .view-btn:hover{border-color:var(--orange);color:var(--orange);background:var(--og)}
    .view-btn svg{width:11px;height:11px}

    /* States */
    .loading-st{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:90px 0}
    .ring{width:42px;height:42px;border:3px solid var(--border);border-top-color:var(--orange);border-radius:50%;animation:spin .75s linear infinite}
    @@keyframes spin{to{transform:rotate(360deg)}}
    .loading-st p{font-family:var(--mono);font-size:10.5px;letter-spacing:2px;color:var(--muted)}
    .empty-st{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:90px 0}
    .empty-st svg{width:48px;height:48px;color:var(--gray1)}
    .empty-st h3{font-family:var(--display);font-size:26px;letter-spacing:1px;color:var(--muted)}
    .empty-st p{font-size:13px;color:var(--muted)}
    .err-box{margin:24px;background:rgba(220,38,38,.05);border:1px solid rgba(220,38,38,.2);border-radius:var(--r);padding:16px 20px;display:flex;align-items:flex-start;gap:12px}
    .err-box svg{width:20px;height:20px;color:#dc2626;flex-shrink:0;margin-top:2px}
    .err-box p{font-size:13px;color:var(--dim)}
    .err-box strong{color:#dc2626}
    .retry-btn{margin-top:8px;background:rgba(220,38,38,.1);border:1px solid rgba(220,38,38,.25);color:#dc2626;padding:5px 14px;border-radius:var(--r);font-size:12px;cursor:pointer;display:block}

    /* Modal */
    .overlay{
      position:fixed;inset:0;background:rgba(0,0,0,.82);z-index:500;
      display:flex;align-items:center;justify-content:center;
      padding:24px;backdrop-filter:blur(8px);
      opacity:0;pointer-events:none;transition:opacity .22s;
      overflow:hidden;
    }
    .overlay.open{opacity:1;pointer-events:auto}
    .modal{
      background:var(--card);border:1px solid var(--border);
      border-radius:var(--r2);width:100%;max-width:700px;max-height:90vh;
      overflow:hidden;display:flex;flex-direction:column;
      transform:translateY(22px) scale(.97);
      transition:transform .28s cubic-bezier(.22,.68,0,1.2);
      box-shadow:0 24px 64px rgba(0,0,0,.5);
      touch-action:pan-y;
      overscroll-behavior:contain;
    }
    .overlay.open .modal{transform:translateY(0) scale(1)}
    .modal-accent{height:4px;background:linear-gradient(90deg,var(--cyan) 0%,var(--cyan3) 100%);flex-shrink:0}
    .modal-img-wrap{height:220px;position:relative;overflow:hidden;flex-shrink:0;background:var(--card2)}
    .modal-img-wrap img{width:100%;height:100%;object-fit:cover;filter:brightness(.7) saturate(.8)}
    .modal-img-wrap::after{content:'';position:absolute;inset:0;background:linear-gradient(to bottom,rgba(13,15,20,.1) 0%,var(--card) 100%)}
    .modal-close-btn{
      position:absolute;top:12px;right:12px;z-index:10;
      background:rgba(13,15,20,.85);border:1px solid var(--border);
      border-radius:50%;width:34px;height:34px;display:flex;align-items:center;justify-content:center;
      cursor:pointer;color:var(--dim);transition:all .14s;
    }
    .modal-close-btn:hover{border-color:var(--cyan);color:var(--cyan)}
    .modal-close-btn svg{width:15px;height:15px}
    .modal-body{
      padding:0 26px 26px;
      overflow-y:auto;
      overflow-x:hidden;
      flex:1;
      touch-action:pan-y;
      overscroll-behavior:contain;
    }
    .modal-name{font-family:var(--display);font-size:32px;letter-spacing:1.5px;color:var(--light);line-height:1;text-transform:capitalize;margin-bottom:10px}
    .modal-tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:18px;overflow:hidden}
    .mtag{padding:3px 11px;border-radius:999px;font-size:10.5px;font-family:var(--mono);letter-spacing:.5px;border:1px solid;text-transform:capitalize;white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis}
    .mtag.m{color:var(--cyan);border-color:var(--cyan);background:var(--og)}
    .mtag.t{color:var(--dim);border-color:var(--border2)}
    .mtag.e{color:var(--dim);border-color:var(--border)}
    .modal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:18px}
    .mstat{background:var(--card2);border:1px solid var(--border);border-radius:var(--r);padding:12px 14px;min-width:0;overflow:hidden}
    .mstat-lbl{font-family:var(--mono);font-size:9.5px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
    .mstat-val{font-size:13px;font-weight:500;color:var(--text);text-transform:capitalize;word-break:break-word}
    .inst-lbl{font-family:var(--mono);font-size:9.5px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:9px}
    .inst-text{font-size:14px;color:var(--dim);line-height:1.75;word-break:break-word;overflow-wrap:break-word}

    /* ── RESPONSIVE ─────────────────────────────────────────── */
    @@media(max-width:900px){
      .intro-hero{
        grid-template-columns:1fr;
        grid-template-rows:auto auto;
        height:auto;
        max-height:none;
      }
      .intro-left{ position:relative; min-height:auto; }
      .intro-left-content{
        position:relative;
        bottom:auto;left:auto;right:auto;
        padding:80px 28px 36px;
      }
      .intro-right{
        height:220px;
        margin-left:0;
        grid-template-columns:1fr 1fr 1fr;
        grid-template-rows:1fr;
      }
      .intro-right::before{
        background:
          linear-gradient(to bottom, var(--surf) 0%, transparent 30%),
          linear-gradient(to top,    var(--bg)   0%, transparent 30%),
          linear-gradient(to right,  var(--bg)   0%, transparent 10%),
          linear-gradient(to left,   var(--bg)   0%, transparent 10%);
      }
      .intro-topbar{padding:0 28px}
      .intro-features{grid-template-columns:1fr 1fr}
    }

    @@media(max-width:600px){
      /* Intro */
      .intro-left-content{padding:72px 20px 28px}
      .intro-right{height:160px}
      .intro-features{grid-template-columns:1fr}
      .intro-stats{gap:8px}
      .istat{padding:8px 12px}
      /* App shell */
      .app-shell{grid-template-columns:1fr}
      /* Topbar — stack search below logo row */
      .app-topbar{
        flex-wrap:wrap;
        padding:8px 14px;
        gap:8px;
        height:auto;
      }
      .back-btn{font-size:11px;padding:5px 10px}
      .app-logo{font-size:18px}
      .app-end{margin-left:auto}
      /* Search bar takes full width on second row */
      .search-wrap{
        order:10;
        flex:1 1 100%;
        max-width:100%;
        min-width:0;
      }
      .search-wrap input{
        font-size:14px;
        padding:9px 34px 9px 38px;
      }
      /* Sidebar becomes horizontal scrolling strip */
      .sidebar{
        display:flex;
        flex-direction:row;
        overflow-x:auto;
        overflow-y:hidden;
        padding:6px 0;
        border-right:none;
        border-bottom:1px solid var(--border);
        scrollbar-width:none;
      }
      .sidebar::-webkit-scrollbar{display:none}
      .sb-label,.sb-rule,.diff-wrap{display:none}
      .nav-item{
        flex-direction:column;
        padding:7px 12px;
        gap:3px;
        border-left:none;
        border-bottom:2px solid transparent;
        min-width:62px;
        align-items:center;
        flex-shrink:0;
      }
      .nav-item.active{
        border-bottom-color:var(--cyan);
        border-left-color:transparent;
        background:transparent;
      }
      .nav-thumb{width:34px;height:34px}
      .nav-thumb svg{width:18px;height:18px}
      .nav-name{font-size:10px;text-align:center;white-space:nowrap}
      .nav-sub{display:none}
      /* Content */
      .content{padding:14px}
      .hero-content{padding:0 16px 18px}
      .chip-row{padding:10px 16px}
      /* App shell rows adjust for taller topbar */
      .app-shell{grid-template-rows:auto auto 1fr}
    }
  </style>
</head>
<body>

