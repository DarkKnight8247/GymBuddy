<script>
  // ─── EXERCISE-SPECIFIC PHOTO ─────────────────────────────────
  // Maps equipment type → curated Unsplash photo IDs.
  // We pick a photo by hashing the exercise name so each card
  // gets a consistent, unique image that won't repeat within a page.
  const EQUIP_PHOTOS = {
    barbell:          ['photo-1534438327276-14e5300c3a48','photo-1583454110551-21f2fa2afe61','photo-1541534741688-6078c6bfb5c5','photo-1517836357463-d25dfeac3438','photo-1526506118085-60ce8714f8c5'],
    dumbbell:         ['photo-1581009137042-c552e485697a','photo-1571019614242-c5c5dee9f50b','photo-1526506118085-60ce8714f8c5','photo-1577221084712-45b0445d2b00','photo-1581009146145-b5ef050c2e1e'],
    'ez barbell':     ['photo-1534438327276-14e5300c3a48','photo-1541534741688-6078c6bfb5c5','photo-1583454110551-21f2fa2afe61','photo-1517836357463-d25dfeac3438','photo-1526506118085-60ce8714f8c5'],
    cable:            ['photo-1532029837206-abbe2b7620e3','photo-1598971457999-ca4ef48a9a71','photo-1571019614242-c5c5dee9f50b','photo-1549060279-7e168fcee0c2','photo-1583454110551-21f2fa2afe61'],
    machine:          ['photo-1549060279-7e168fcee0c2','photo-1598971457999-ca4ef48a9a71','photo-1541534741688-6078c6bfb5c5','photo-1571019614242-c5c5dee9f50b','photo-1532029837206-abbe2b7620e3'],
    'leverage machine':['photo-1549060279-7e168fcee0c2','photo-1532029837206-abbe2b7620e3','photo-1598971457999-ca4ef48a9a71','photo-1583454110551-21f2fa2afe61','photo-1571019614242-c5c5dee9f50b'],
    band:             ['photo-1571019613914-85f342c6a11e','photo-1476480862126-209bfaa8edc8','photo-1434608519344-49d77a699e1d','photo-1571019613454-1cb2f99b2d8b','photo-1574680178050-55c6a6a96e0a'],
    kettlebell:       ['photo-1517836357463-d25dfeac3438','photo-1534438327276-14e5300c3a48','photo-1526506118085-60ce8714f8c5','photo-1581009137042-c552e485697a','photo-1583454110551-21f2fa2afe61'],
    'body weight':    ['photo-1571019613914-85f342c6a11e','photo-1476480862126-209bfaa8edc8','photo-1574680178050-55c6a6a96e0a','photo-1434608519344-49d77a699e1d','photo-1571019613454-1cb2f99b2d8b'],
    bodyweight:       ['photo-1571019613914-85f342c6a11e','photo-1476480862126-209bfaa8edc8','photo-1574680178050-55c6a6a96e0a','photo-1434608519344-49d77a699e1d','photo-1571019613454-1cb2f99b2d8b'],
    'medicine ball':  ['photo-1517836357463-d25dfeac3438','photo-1571019613914-85f342c6a11e','photo-1476480862126-209bfaa8edc8','photo-1574680178050-55c6a6a96e0a','photo-1434608519344-49d77a699e1d'],
    cardio:           ['photo-1476480862126-209bfaa8edc8','photo-1571019613454-1cb2f99b2d8b','photo-1434608519344-49d77a699e1d','photo-1574680178050-55c6a6a96e0a','photo-1535914254981-b5012eebbd15'],
    default:          ['photo-1583454110551-21f2fa2afe61','photo-1571019614242-c5c5dee9f50b','photo-1581009137042-c552e485697a','photo-1534438327276-14e5300c3a48','photo-1532029837206-abbe2b7620e3'],
  };

  function getExercisePhoto(ex) {
    const equip = (Array.isArray(ex.equipment) ? ex.equipment[0] : ex.equipment || '').toLowerCase().trim();
    const pool  = EQUIP_PHOTOS[equip] || EQUIP_PHOTOS.default;
    // Seed from exercise name so same exercise = same photo every render
    const seed  = (ex.name || '').split('').reduce((a, c) => a + c.charCodeAt(0), 0);
    const id    = pool[seed % pool.length];
    return `https://images.unsplash.com/${id}?w=600&h=380&fit=crop&q=80`;
  }

  // Hero banner — muscle-group keyed fixed photos for stable banner
  const HERO_PHOTOS = {
    lower_back:  'photo-1583454110551-21f2fa2afe61',
    shoulders:   'photo-1571019614242-c5c5dee9f50b',
    biceps:      'photo-1581009137042-c552e485697a',
    triceps:     'photo-1581009146145-b5ef050c2e1e',
    forearms:    'photo-1526506118085-60ce8714f8c5',
    chest:       'photo-1534438327276-14e5300c3a48',
    quadriceps:  'photo-1574680178050-55c6a6a96e0a',
    hamstrings:  'photo-1434608519344-49d77a699e1d',
    calves:      'photo-1476480862126-209bfaa8edc8',
    glutes:      'photo-1571019613454-1cb2f99b2d8b',
    abdominals:  'photo-1571019613914-85f342c6a11e',
    lats:        'photo-1598971457999-ca4ef48a9a71',
    traps:       'photo-1532029837206-abbe2b7620e3',
    neck:        'photo-1549060279-7e168fcee0c2',
    cardio:      'photo-1476480862126-209bfaa8edc8',
  };
  function getHeroPhoto(muscle) {
    const id = HERO_PHOTOS[muscle] || 'photo-1583454110551-21f2fa2afe61';
    return `https://images.unsplash.com/${id}?w=1400&h=260&fit=crop&q=85`;
  }

  // ─── CONFIG ───────────────────────────────────────────────────
  const PROXY = '/Exercise/ByMuscle';
  const TYPES = ['strength','stretching','plyometrics','powerlifting','cardio','olympic_weightlifting','strongman'];

  // ─── STATE ────────────────────────────────────────────────────
  let currentMuscle = 'back', currentType = '';
  let activeDiff = '', activeType = '', searchQuery = '';
  let allFetched = [], appInitialized = false;

  // ─── NAV ──────────────────────────────────────────────────────
  function goToApp() {
    document.getElementById('introPage').style.display = 'none';
    const ap = document.getElementById('appPage');
    ap.style.display = 'flex'; ap.classList.add('active');
    if (!appInitialized) {
      appInitialized = true;
      buildTypeChips(); loadExercises();
      document.getElementById('searchInput').addEventListener('input', e => {
        searchQuery = e.target.value.toLowerCase(); applyAndRender();
      });
    }
  }
  function goToIntro() {
    document.getElementById('appPage').style.display = 'none';
    document.getElementById('introPage').style.display = 'flex';
  }

  function buildTypeChips() {
    const w = document.getElementById('typeChips');
    TYPES.forEach(t => {
      const b = document.createElement('button');
      b.className = 'chip'; b.textContent = t.replace(/_/g,' '); b.dataset.t = t;
      b.onclick = () => toggleType(b, t); w.appendChild(b);
    });
  }
  function toggleType(btn, t) {
    if (activeType === t) { activeType = ''; btn.classList.remove('active'); }
    else { document.querySelectorAll('.chip').forEach(c=>c.classList.remove('active')); activeType = t; btn.classList.add('active'); }
    applyAndRender();
  }

  function selectNav(el) {
    document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
    el.classList.add('active');
    currentMuscle = el.dataset.muscle; currentType = el.dataset.type;
    activeType = ''; document.querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));
    const nm = el.querySelector('.nav-name').textContent;
    const sub = el.querySelector('.nav-sub').textContent;
    document.getElementById('heroEye').textContent = sub || 'Muscle Group';
    document.getElementById('heroTitle').innerHTML = nm + ' <em>Exercises</em>';
    document.getElementById('heroImg').src = getHeroPhoto(currentMuscle);
    loadExercises();
  }

  // ─── DIFFICULTY ───────────────────────────────────────────────
  // source = 'sidebar' | 'bar' — keeps both UIs in sync
  function selectDiff(btn, source) {
    activeDiff = btn.dataset.diff;
    document.querySelectorAll('.diff-bar-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.diff === activeDiff);
    });
    applyAndRender();
  }

  // ─── LOAD  ────────────────────────────────────────────────────
  // FIX: ignore 502/non-ok responses silently — API returns 502
  // when offset exceeds available results (not a real error).
  async function loadExercises() {
    showLoading(); allFetched = [];
    await fetchBatch(0);
    applyAndRender();
  }

  async function fetchBatch(offset) {
    try {
      const p = new URLSearchParams();
      if (currentMuscle) p.set('muscle', currentMuscle);
      if (currentType)   p.set('muscle', currentType); // cardio uses type as muscle key
      p.set('offset', offset);
      p.set('limit', 50);
      const res = await fetch(`${PROXY}?${p}`);
      if (res.status === 404) return;
      if (!res.ok) {
        if (offset === 0) {
          const errBody = await res.json().catch(() => ({ error: `HTTP ${res.status}` }));
          showError(errBody.error || errBody.body || `HTTP ${res.status}`);
        }
        return;
      }
      const d = await res.json();
      if (Array.isArray(d)) allFetched.push(...d);
      else if (d && typeof d === 'object') allFetched.push(d);
    } catch(e) {
      if (offset === 0) showError(e.message);
    }
  }

  // ─── FILTER + RENDER ──────────────────────────────────────────
  function applyAndRender() {
    const filtered = allFetched.filter(ex => {
      if (activeDiff && (ex.difficulty||'').toLowerCase() !== activeDiff) return false;
      if (activeType && (ex.category||ex.type||'').toLowerCase() !== activeType) return false;
      if (searchQuery) {
        const h = [ex.name, ex.target, ex.bodyPart, ex.category, ex.difficulty, ex.equipment]
          .join(' ').toLowerCase();
        if (!h.includes(searchQuery)) return false;
      }
      return true;
    });
    document.getElementById('countNum').textContent = filtered.length;
    document.getElementById('heroMeta').textContent =
      `${filtered.length} exercise${filtered.length!==1?'s':''} found`;
    renderGrid(filtered);
  }

  function renderGrid(data) {
    const grid = document.getElementById('exGrid');
    const empty = document.getElementById('emptyState');
    document.getElementById('loadingState').style.display = 'none';
    if (!data.length) { grid.style.display='none'; empty.style.display='flex'; return; }
    empty.style.display='none'; grid.style.display='grid'; grid.innerHTML='';
    data.forEach((ex, i) => grid.appendChild(buildCard(ex, i)));
  }

  // ─── BUILD CARD ───────────────────────────────────────────────
  function buildCard(ex, i) {
    const card = document.createElement('div');
    card.className = 'ex-card';
    card.style.animationDelay = Math.min(i*.05,.7)+'s';

    // ExerciseDB returns gifUrl — use it, fallback to stock photo
    const imgSrc   = ex.gifUrl || getExercisePhoto(ex);
    const muscle   = ex.target   || ex.bodyPart || '';
    const equip    = ex.equipment || 'Bodyweight';
    const diffCls  = (ex.difficulty||'').toLowerCase();
    const category = (ex.category || ex.type || '').replace(/_/g,' ');
    const desc     = Array.isArray(ex.instructions)
      ? ex.instructions.slice(0,2).join(' ')
      : (ex.description || ex.instructions || 'No description available.');

    card.innerHTML = `
      <div class="card-accent"></div>
      <div class="card-img-wrap">
        <img src="${imgSrc}" alt="${ex.name}" loading="lazy" />
        ${diffCls ? `<div class="diff-badge ${diffCls}">${cap(ex.difficulty)}</div>` : ''}
        <div class="type-badge">${cap(category) || cap(ex.bodyPart||'')}</div>
      </div>
      <div class="card-body">
        <div class="card-name">${cap(ex.name)}</div>
        <div class="card-muscle"><div class="muscle-pip"></div><span>${cap(muscle)}</span></div>
        <p class="card-desc">${desc}</p>
      </div>
      <div class="card-foot">
        <span class="card-equip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 4v16M18 4v16M3 8h3M18 8h3M3 16h3M18 16h3M6 8h12M6 16h12"/></svg>
          ${cap(equip)}
        </span>
        <button class="view-btn">View <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></button>
      </div>`;

    card.onclick = () => openModal(ex, imgSrc);
    card.querySelector('.view-btn').onclick = e => { e.stopPropagation(); openModal(ex, imgSrc); };
    return card;
  }

  // ─── MODAL ────────────────────────────────────────────────────
  function openModal(ex, imgSrc) {
    document.getElementById('mImg').src = imgSrc;
    document.getElementById('mName').textContent = cap(ex.name||'');

    const muscle   = ex.target || ex.bodyPart || '—';
    const equip    = ex.equipment || 'Bodyweight';
    const diffCls  = (ex.difficulty||'').toLowerCase();
    const dcol     = {beginner:'#22c55e',intermediate:'#3DF2E0',expert:'#ef4444'}[diffCls]||'#5a7a9a';
    const secondary = Array.isArray(ex.secondaryMuscles) ? ex.secondaryMuscles : [];
    const instructions = Array.isArray(ex.instructions)
      ? ex.instructions.join(' ')
      : (ex.description || ex.instructions || 'No instructions available.');

    document.getElementById('mTags').innerHTML =
      `<span class="mtag m">${cap(muscle)}</span>
       <span class="mtag t">${cap(ex.bodyPart||'—')}</span>
       <span class="mtag e">${cap(equip)}</span>
       ${diffCls ? `<span class="mtag" style="color:${dcol};border-color:${dcol};background:${dcol}18">${cap(ex.difficulty)}</span>` : ''}
       ${secondary.slice(0,3).map(s=>`<span class="mtag e">${cap(s)}</span>`).join('')}`;

    document.getElementById('mGrid').innerHTML =
      `<div class="mstat"><div class="mstat-lbl">Target</div><div class="mstat-val">${cap(muscle)}</div></div>
       <div class="mstat"><div class="mstat-lbl">Body Part</div><div class="mstat-val">${cap(ex.bodyPart||'—')}</div></div>
       <div class="mstat"><div class="mstat-lbl">${ex.difficulty ? 'Difficulty' : 'Equipment'}</div><div class="mstat-val" style="${ex.difficulty ? `color:${dcol}` : ''}">${ex.difficulty ? cap(ex.difficulty) : cap(equip)}</div></div>`;

    document.getElementById('mInst').textContent = instructions;
    document.getElementById('overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeModal() { document.getElementById('overlay').classList.remove('open'); document.body.style.overflow=''; }
  function closeOutside(e) { if(e.target===document.getElementById('overlay')) closeModal(); }
  document.addEventListener('keydown', e => { if(e.key==='Escape') closeModal(); });

  function cap(s) { return s?s.replace(/\b\w/g,c=>c.toUpperCase()):''; }
  function showLoading() {
    document.getElementById('loadingState').style.display='flex';
    document.getElementById('exGrid').style.display='none';
    document.getElementById('emptyState').style.display='none';
    document.querySelectorAll('.err-box').forEach(e=>e.remove());
  }
  function clearSearch() { document.getElementById('searchInput').value=''; searchQuery=''; applyAndRender(); }
</script>
</body>
</html>
