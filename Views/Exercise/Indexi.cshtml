@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GymBuddy — ExerciseDB</title>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=Barlow:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg:          #0e0e0e;
      --surface:     #181818;
      --card:        #202020;
      --border:      #2e2e2e;
      --muted:       #555;
      --text-dim:    #888;
      --text:        #d8d8d8;
      --white:       #f2f2f2;
      --orange:      #f46b1e;
      --orange-glow: rgba(244,107,30,.15);
      --radius:      10px;
      --font-head:   'Barlow Condensed', sans-serif;
      --font-body:   'Barlow', sans-serif;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { background: var(--bg); color: var(--text); font-family: var(--font-body); font-size: 15px; line-height: 1.55; min-height: 100vh; }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--orange); }

    /* ── SHELL ── */
    .shell { display: grid; grid-template-columns: 230px 1fr; grid-template-rows: 64px 1fr; min-height: 100vh; }

    /* ── TOP BAR ── */
    .topbar {
      grid-column: 1/-1;
      display: flex; align-items: center; gap: 18px;
      padding: 0 24px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      position: sticky; top: 0; z-index: 100;
    }
    .logo {
      font-family: var(--font-head); font-weight: 800; font-size: 21px;
      color: var(--white); display: flex; align-items: center; gap: 9px; white-space: nowrap;
    }
    .logo-icon {
      width: 30px; height: 30px; background: var(--orange); border-radius: 7px;
      display: flex; align-items: center; justify-content: center;
    }
    .logo-icon svg { width: 17px; height: 17px; fill: #fff; }
    .logo span { color: var(--orange); }

    .search-wrap { flex: 1; max-width: 400px; position: relative; }
    .search-wrap input {
      width: 100%; background: var(--card); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 8px 36px 8px 38px;
      color: var(--text); font-family: var(--font-body); font-size: 14px; outline: none;
      transition: border-color .2s;
    }
    .search-wrap input::placeholder { color: var(--muted); }
    .search-wrap input:focus { border-color: var(--orange); }
    .s-ico { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
    .s-clr { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--muted); cursor: pointer; font-size: 17px; display: none; }
    .search-wrap input:not(:placeholder-shown) ~ .s-clr { display: block; }

    .topbar-right { margin-left: auto; display: flex; align-items: center; gap: 10px; }
    .stat-pill { background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 5px 13px; font-size: 12px; color: var(--text-dim); white-space: nowrap; }
    .stat-pill strong { color: var(--orange); }

    /* ── SIDEBAR ── */
    .sidebar { background: var(--surface); border-right: 1px solid var(--border); padding: 22px 0; overflow-y: auto; }
    .sidebar-label { font-family: var(--font-head); font-size: 11px; font-weight: 700; letter-spacing: 2px; color: var(--muted); text-transform: uppercase; padding: 0 18px 10px; }
    .nav-item {
      display: flex; align-items: center; gap: 11px;
      padding: 10px 18px; cursor: pointer;
      border-left: 3px solid transparent;
      color: var(--text-dim); font-size: 13.5px; font-weight: 500;
      transition: background .15s, color .15s; user-select: none;
    }
    .nav-item:hover { background: var(--card); color: var(--text); }
    .nav-item.active { background: var(--card); border-left-color: var(--orange); color: var(--white); }
    .nav-icon {
      width: 32px; height: 32px; border-radius: 7px; background: var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; flex-shrink: 0; transition: background .15s;
    }
    .nav-item.active .nav-icon { background: var(--orange); }
    .sidebar-divider { height: 1px; background: var(--border); margin: 14px 18px; }

    /* ── DIFFICULTY FILTER in sidebar ── */
    .diff-wrap { padding: 0 18px; }
    .diff-wrap select {
      width: 100%; background: var(--card); border: 1px solid var(--border);
      color: var(--text); font-family: var(--font-body); font-size: 13px;
      padding: 8px 10px; border-radius: var(--radius); outline: none; cursor: pointer;
    }

    /* ── MAIN ── */
    .main { overflow-y: auto; display: flex; flex-direction: column; }

    .page-header { padding: 26px 28px 18px; border-bottom: 1px solid var(--border); background: var(--surface); }
    .breadcrumb { font-size: 12px; color: var(--muted); margin-bottom: 5px; }
    .breadcrumb span { color: var(--orange); }
    .page-title { font-family: var(--font-head); font-size: 34px; font-weight: 800; letter-spacing: .4px; color: var(--white); line-height: 1; margin-bottom: 5px; text-transform: uppercase; }
    .page-title em { color: var(--orange); font-style: normal; }
    .page-meta { font-size: 13px; color: var(--text-dim); }

    /* ── TYPE CHIPS ── */
    .filters-bar { display: flex; align-items: center; gap: 8px; padding: 14px 28px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
    .filter-label { font-size: 12px; color: var(--muted); font-weight: 500; }
    .chip { padding: 5px 13px; border-radius: 999px; border: 1px solid var(--border); background: none; color: var(--text-dim); font-size: 12px; font-family: var(--font-body); cursor: pointer; transition: all .15s; white-space: nowrap; }
    .chip:hover { border-color: var(--orange); color: var(--orange); }
    .chip.active { background: var(--orange); border-color: var(--orange); color: #fff; font-weight: 600; }

    /* ── GRID ── */
    .content-area { padding: 24px 28px; flex: 1; }
    .exercise-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 18px; }

    /* ── CARD ── */
    .ex-card {
      background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
      display: flex; flex-direction: column; cursor: pointer;
      transition: transform .2s, border-color .2s, box-shadow .2s;
      animation: fadeUp .3s ease both;
    }
    .ex-card:hover { transform: translateY(-3px); border-color: var(--orange); box-shadow: 0 8px 28px rgba(0,0,0,.45); }
    @@keyframes fadeUp { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:translateY(0); } }

    .card-body { padding: 16px; flex: 1; display: flex; flex-direction: column; gap: 10px; }
    .card-name { font-family: var(--font-head); font-size: 18px; font-weight: 700; color: var(--white); line-height: 1.2; text-transform: capitalize; }
    .card-tags { display: flex; flex-wrap: wrap; gap: 6px; }
    .tag { font-size: 11px; padding: 3px 9px; border-radius: 4px; background: var(--surface); border: 1px solid var(--border); color: var(--text-dim); text-transform: capitalize; }
    .tag.muscle  { border-color: var(--orange); color: var(--orange); background: var(--orange-glow); }
    .tag.diff-beginner    { border-color: #3a7d44; color: #5bbd74; background: rgba(91,189,116,.1); }
    .tag.diff-intermediate{ border-color: #b8860b; color: #f0b429; background: rgba(240,180,41,.1); }
    .tag.diff-expert      { border-color: #8b1a1a; color: #e05252; background: rgba(224,82,82,.1); }

    .card-instructions { font-size: 12.5px; color: var(--text-dim); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

    .card-footer { padding: 11px 16px; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
    .card-footer-info { font-size: 12px; color: var(--muted); }
    .card-footer-info strong { color: var(--text-dim); text-transform: capitalize; }
    .card-btn { background: none; border: 1px solid var(--border); color: var(--text-dim); border-radius: 6px; padding: 5px 12px; font-size: 12px; cursor: pointer; font-family: var(--font-body); transition: all .15s; }
    .card-btn:hover { border-color: var(--orange); color: var(--orange); background: var(--orange-glow); }

    /* ── NO-IMAGE BANNER ── */
    .card-banner {
      width: 100%; height: 7px;
      background: linear-gradient(90deg, var(--orange) 0%, var(--orange-dim, #b84e0e) 100%);
      opacity: .7;
    }
    .ex-card:hover .card-banner { opacity: 1; }

    /* ── LOADING / EMPTY / ERROR ── */
    .loading-state { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:18px; padding:80px 0; color:var(--muted); }
    .spinner { width:38px; height:38px; border:3px solid var(--border); border-top-color:var(--orange); border-radius:50%; animation:spin .7s linear infinite; }
    @@keyframes spin { to { transform:rotate(360deg); } }
    .loading-state p { font-size:14px; }

    .empty-state { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; padding:80px 0; color:var(--muted); }
    .empty-state svg { width:52px; height:52px; opacity:.3; }
    .empty-state h3 { font-family:var(--font-head); font-size:22px; color:var(--text-dim); }
    .empty-state p { font-size:13px; }

    .error-box { background:rgba(244,107,30,.07); border:1px solid rgba(244,107,30,.25); border-radius:var(--radius); padding:18px 22px; display:flex; align-items:flex-start; gap:13px; margin:24px 28px; }
    .error-box svg { width:22px; height:22px; color:var(--orange); flex-shrink:0; margin-top:2px; }
    .error-box p { font-size:13px; color:var(--text-dim); }
    .error-box strong { color:var(--orange); }
    .retry-btn { margin-top:8px; background:var(--orange); border:none; color:#fff; padding:6px 16px; border-radius:6px; font-family:var(--font-body); font-size:13px; cursor:pointer; }

    /* ── PAGINATION ── */
    .pagination { display:flex; align-items:center; justify-content:center; gap:7px; padding:22px 28px 30px; }
    .page-btn { min-width:34px; height:34px; border-radius:7px; border:1px solid var(--border); background:none; color:var(--text-dim); font-family:var(--font-body); font-size:13px; cursor:pointer; display:flex; align-items:center; justify-content:center; padding:0 9px; transition:all .15s; }
    .page-btn:hover { border-color:var(--orange); color:var(--orange); }
    .page-btn.active { background:var(--orange); border-color:var(--orange); color:#fff; font-weight:700; }
    .page-btn:disabled { opacity:.3; cursor:not-allowed; }
    .page-info { font-size:12px; color:var(--muted); margin:0 6px; }

    /* ── MODAL ── */
    .modal-overlay {
      position:fixed; inset:0; background:rgba(0,0,0,.78); z-index:200;
      display:flex; align-items:center; justify-content:center; padding:20px;
      backdrop-filter:blur(5px); opacity:0; pointer-events:none; transition:opacity .2s;
    }
    .modal-overlay.open { opacity:1; pointer-events:auto; }
    .modal {
      background:var(--card); border:1px solid var(--border); border-radius:14px;
      width:100%; max-width:660px; max-height:90vh; overflow-y:auto;
      transform:translateY(18px); transition:transform .25s;
    }
    .modal-overlay.open .modal { transform:translateY(0); }
    .modal-top-bar { height:6px; background:linear-gradient(90deg,var(--orange),#ff9452); border-radius:14px 14px 0 0; }
    .modal-header { padding:20px 22px 16px; border-bottom:1px solid var(--border); display:flex; align-items:flex-start; justify-content:space-between; gap:14px; }
    .modal-name { font-family:var(--font-head); font-size:26px; font-weight:800; color:var(--white); text-transform:capitalize; line-height:1.1; margin-bottom:8px; }
    .modal-close { background:none; border:none; color:var(--muted); cursor:pointer; font-size:22px; line-height:1; transition:color .15s; flex-shrink:0; }
    .modal-close:hover { color:var(--orange); }
    .modal-body { padding:20px 22px; display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; }
    .m-sec { display:flex; flex-direction:column; gap:5px; }
    .m-sec.full { grid-column:1/-1; }
    .m-label { font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--orange); }
    .m-val { font-size:15px; color:var(--white); text-transform:capitalize; font-weight:500; }
    .m-instructions { font-size:13.5px; color:var(--text-dim); line-height:1.65; }
    .m-equipment-list { display:flex; flex-wrap:wrap; gap:6px; }
    .equip-tag { padding:4px 11px; border-radius:5px; background:var(--surface); border:1px solid var(--border); font-size:12px; color:var(--text-dim); text-transform:capitalize; }

    /* ── RESPONSIVE ── */
    @@media (max-width: 768px) {
      .shell { grid-template-columns:1fr; grid-template-rows:64px auto 1fr; }
      .sidebar { grid-row:2; padding:10px 0; border-right:none; border-bottom:1px solid var(--border); display:flex; overflow-x:auto; overflow-y:hidden; white-space:nowrap; }
      .sidebar-label, .sidebar-divider, .diff-wrap { display:none; }
      .nav-item { padding:8px 14px; flex-direction:column; gap:3px; font-size:11px; border-left:none; border-bottom:3px solid transparent; }
      .nav-item.active { border-left-color:transparent; border-bottom-color:var(--orange); }
      .content-area { padding:14px; }
      .filters-bar { padding:10px 14px; }
      .page-header { padding:18px 14px 12px; }
      .modal-body { grid-template-columns:1fr 1fr; }
    }
  </style>
</head>
<body>

<div class="shell">

  <!-- TOP BAR -->
  <header class="topbar">
    <div class="logo">
      <div class="logo-icon">
        <svg viewBox="0 0 24 24"><path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43L16.29 22l2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43L22 16.29l-1.43-1.43z"/></svg>
      </div>
      Gym<span>Buddy</span>
    </div>
    <div class="search-wrap">
      <svg class="s-ico" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="searchInput" placeholder="Search exercises…" />
      <button class="s-clr" onclick="clearSearch()">×</button>
    </div>
    <div class="topbar-right">
      <div class="stat-pill">Showing <strong id="countDisplay">—</strong> results</div>
    </div>
  </header>

  <!-- SIDEBAR -->
  <nav class="sidebar">
    <div class="sidebar-label">Muscle Group</div>

    <div class="nav-item active" data-muscle="back" data-type="" onclick="selectNav(this)">
      <div class="nav-icon">🏋️</div><span>Back</span>
    </div>
    <div class="nav-item" data-muscle="shoulders" data-type="" onclick="selectNav(this)">
      <div class="nav-icon">💪</div><span>Shoulders</span>
    </div>
    <div class="nav-item" data-muscle="biceps" data-type="" onclick="selectNav(this)">
      <div class="nav-icon">🦾</div><span>Biceps</span>
    </div>
    <div class="nav-item" data-muscle="triceps" data-type="" onclick="selectNav(this)">
      <div class="nav-icon">✊</div><span>Triceps</span>
    </div>
    <div class="nav-item" data-muscle="forearms" data-type="" onclick="selectNav(this)">
      <div class="nav-icon">🤜</div><span>Forearms</span>
    </div>
    <div class="nav-item" data-muscle="chest" data-type="" onclick="selectNav(this)">
      <div class="nav-icon">🫁</div><span>Chest</span>
    </div>
    <div class="nav-item" data-muscle="quadriceps" data-type="" onclick="selectNav(this)">
      <div class="nav-icon">🦵</div><span>Quadriceps</span>
    </div>
    <div class="nav-item" data-muscle="hamstrings" data-type="" onclick="selectNav(this)">
      <div class="nav-icon">🦿</div><span>Hamstrings</span>
    </div>
    <div class="nav-item" data-muscle="calves" data-type="" onclick="selectNav(this)">
      <div class="nav-icon">🦶</div><span>Calves</span>
    </div>
    <div class="nav-item" data-muscle="glutes" data-type="" onclick="selectNav(this)">
      <div class="nav-icon">🍑</div><span>Glutes</span>
    </div>
    <div class="nav-item" data-muscle="abdominals" data-type="" onclick="selectNav(this)">
      <div class="nav-icon">🎯</div><span>Abdominals</span>
    </div>
    <div class="nav-item" data-muscle="lats" data-type="" onclick="selectNav(this)">
      <div class="nav-icon">🏊</div><span>Lats</span>
    </div>
    <div class="nav-item" data-muscle="traps" data-type="" onclick="selectNav(this)">
      <div class="nav-icon">🧱</div><span>Traps</span>
    </div>
    <div class="nav-item" data-muscle="neck" data-type="" onclick="selectNav(this)">
      <div class="nav-icon">🧘</div><span>Neck</span>
    </div>
    <div class="nav-item" data-muscle="" data-type="cardio" onclick="selectNav(this)">
      <div class="nav-icon">🏃</div><span>Cardio</span>
    </div>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">Difficulty</div>
    <div class="diff-wrap">
      <select id="diffSelect" onchange="loadExercises()">
        <option value="">All Levels</option>
        <option value="beginner">Beginner</option>
        <option value="intermediate">Intermediate</option>
        <option value="expert">Expert</option>
      </select>
    </div>
  </nav>

  <!-- MAIN -->
  <main class="main" id="mainPanel">

    <div class="page-header">
      <div class="breadcrumb">GymBuddy &rsaquo; <span id="breadPart">Back</span></div>
      <h1 class="page-title" id="pageTitle">Back <em>Exercises</em></h1>
      <p class="page-meta" id="pageMeta">Loading…</p>
    </div>

    <div class="filters-bar">
      <span class="filter-label">Type:</span>
      <div id="typeChips"></div>
    </div>

    <div class="content-area" id="contentArea">
      <div class="loading-state" id="loadingState">
        <div class="spinner"></div>
        <p>Fetching exercises…</p>
      </div>
      <div class="exercise-grid" id="exerciseGrid" style="display:none"></div>
      <div class="empty-state" id="emptyState" style="display:none">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <h3>No Exercises Found</h3>
        <p>Try adjusting filters or search query.</p>
      </div>
    </div>

    <div class="pagination" id="pagination"></div>
  </main>
</div>

<!-- MODAL -->
<div class="modal-overlay" id="modalOverlay" onclick="closeModalOutside(event)">
  <div class="modal">
    <div class="modal-top-bar"></div>
    <div class="modal-header">
      <div>
        <div class="modal-name" id="mName"></div>
        <div class="card-tags" id="mTags"></div>
      </div>
      <button class="modal-close" onclick="closeModal()">×</button>
    </div>
    <div class="modal-body">
      <div class="m-sec"><div class="m-label">Muscle</div><div class="m-val" id="mMuscle"></div></div>
      <div class="m-sec"><div class="m-label">Type</div><div class="m-val" id="mType"></div></div>
      <div class="m-sec"><div class="m-label">Difficulty</div><div class="m-val" id="mDiff"></div></div>
      <div class="m-sec full" id="mEquipWrap">
        <div class="m-label">Equipment</div>
        <div class="m-equipment-list" id="mEquip"></div>
      </div>
      <div class="m-sec full">
        <div class="m-label">Instructions</div>
        <div class="m-instructions" id="mInstructions"></div>
      </div>
    </div>
  </div>
</div>

<script>
  // ── STATE ────────────────────────────────────────────────────
  const PROXY       = '/Exercise/ByMuscle';
  const PAGE_SIZE   = 10;   // API Ninjas returns max 10 per call

  let currentMuscle = 'back';
  let currentType   = '';
  let activeType    = '';   // type chip filter
  let searchQuery   = '';
  let allExercises  = [];   // current page from API
  let apiOffset     = 0;    // API-level offset for pagination
  let totalFetched  = [];   // accumulate all pages for client filtering

  // ── INIT ─────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => {
    buildTypeChips();
    loadExercises();
    document.getElementById('searchInput').addEventListener('input', e => {
      searchQuery = e.target.value.toLowerCase();
      renderGrid(applyClientFilters());
    });
  });

  const TYPE_VALUES = ['cardio','olympic_weightlifting','plyometrics','powerlifting','strength','stretching','strongman'];

  function buildTypeChips() {
    const wrap = document.getElementById('typeChips');
    TYPE_VALUES.forEach(t => {
      const b = document.createElement('button');
      b.className = 'chip';
      b.textContent = t.replace(/_/g,' ');
      b.dataset.t = t;
      b.onclick = () => toggleTypeChip(b, t);
      wrap.appendChild(b);
    });
  }

  function toggleTypeChip(btn, t) {
    if (activeType === t) { activeType = ''; btn.classList.remove('active'); }
    else { document.querySelectorAll('#typeChips .chip').forEach(c=>c.classList.remove('active')); activeType = t; btn.classList.add('active'); }
    renderGrid(applyClientFilters());
  }

  // ── SELECT NAV ────────────────────────────────────────────────
  function selectNav(el) {
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    el.classList.add('active');
    currentMuscle = el.dataset.muscle;
    currentType   = el.dataset.type;
    activeType    = '';
    document.querySelectorAll('#typeChips .chip').forEach(c=>c.classList.remove('active'));
    totalFetched  = [];
    apiOffset     = 0;
    const label = el.querySelector('span').textContent;
    document.getElementById('breadPart').textContent = label;
    document.getElementById('pageTitle').innerHTML = label + ' <em>Exercises</em>';
    loadExercises();
  }

  // ── LOAD FROM API ─────────────────────────────────────────────
  async function loadExercises() {
    showLoading();
    totalFetched = [];
    apiOffset    = 0;
    // Fetch multiple pages to get more results (API returns max 10 per call)
    await fetchBatch(0);
    await fetchBatch(10);
    await fetchBatch(20);
    await fetchBatch(30);
    await fetchBatch(40);
    renderGrid(applyClientFilters());
  }

  async function fetchBatch(offset) {
    try {
      const diff = document.getElementById('diffSelect').value;
      const params = new URLSearchParams();
      if (currentMuscle) params.set('muscle', currentMuscle);
      if (currentType)   params.set('type',   currentType);
      if (diff)          params.set('difficulty', diff);
      params.set('offset', offset);

      const res = await fetch(`${PROXY}?${params}`);
      if (!res.ok) { showError(`Server returned ${res.status}`); return; }
      const data = await res.json();
      if (Array.isArray(data) && data.length > 0) {
        totalFetched.push(...data);
      }
    } catch (e) {
      showError(e.message);
    }
  }

  // ── CLIENT FILTERS ────────────────────────────────────────────
  function applyClientFilters() {
    return totalFetched.filter(ex => {
      if (activeType && ex.type !== activeType) return false;
      if (searchQuery) {
        const hay = [ex.name, ex.muscle, ex.type, ex.difficulty, ...(ex.equipment||[])].join(' ').toLowerCase();
        if (!hay.includes(searchQuery)) return false;
      }
      return true;
    });
  }

  // ── RENDER GRID ───────────────────────────────────────────────
  function renderGrid(data) {
    const grid  = document.getElementById('exerciseGrid');
    const empty = document.getElementById('emptyState');
    document.getElementById('loadingState').style.display = 'none';
    document.getElementById('countDisplay').textContent = data.length;
    document.getElementById('pageMeta').textContent = `${data.length} exercise${data.length!==1?'s':''} loaded`;

    if (data.length === 0) {
      grid.style.display = 'none'; empty.style.display = 'flex';
      document.getElementById('pagination').innerHTML = '';
      return;
    }
    empty.style.display = 'none';
    grid.style.display = 'grid';
    grid.innerHTML = '';
    data.forEach((ex, i) => grid.appendChild(buildCard(ex, i)));
    document.getElementById('pagination').innerHTML = '';
  }

  // ── BUILD CARD ────────────────────────────────────────────────
  function buildCard(ex, i) {
    const card = document.createElement('div');
    card.className = 'ex-card';
    card.style.animationDelay = (i * 0.04) + 's';

    const diffClass = 'diff-' + (ex.difficulty || '');
    const equipList = Array.isArray(ex.equipment) ? ex.equipment : (ex.equipment ? [ex.equipment] : []);
    const equipStr  = equipList.length ? equipList.join(', ') : 'bodyweight';

    const safeEx = JSON.stringify(ex).replace(/'/g, "\\'").replace(/"/g, '&quot;');

    card.innerHTML = `
      <div class="card-banner"></div>
      <div class="card-body">
        <div class="card-name">${cap(ex.name)}</div>
        <div class="card-tags">
          <span class="tag muscle">${cap(ex.muscle||'—')}</span>
          <span class="tag ${diffClass}">${cap(ex.difficulty||'—')}</span>
          <span class="tag">${(ex.type||'').replace(/_/g,' ')}</span>
        </div>
        <div class="card-instructions">${ex.instructions || 'No instructions available.'}</div>
      </div>
      <div class="card-footer">
        <div class="card-footer-info">Equip: <strong>${equipStr}</strong></div>
        <button class="card-btn" onclick="openModal(${safeEx})">Details</button>
      </div>`;

    card.onclick = (e) => { if (!e.target.closest('.card-btn')) openModal(ex); };
    return card;
  }

  // ── MODAL ─────────────────────────────────────────────────────
  function openModal(ex) {
    document.getElementById('mName').textContent = cap(ex.name||'');
    document.getElementById('mMuscle').textContent = cap(ex.muscle||'—');
    document.getElementById('mType').textContent = (ex.type||'—').replace(/_/g,' ');
    document.getElementById('mDiff').textContent = cap(ex.difficulty||'—');
    document.getElementById('mInstructions').textContent = ex.instructions || 'No instructions available.';

    const equipList = Array.isArray(ex.equipment) ? ex.equipment : (ex.equipment ? [ex.equipment] : []);
    const equipWrap = document.getElementById('mEquip');
    equipWrap.innerHTML = equipList.length
      ? equipList.map(e => `<span class="equip-tag">${cap(e)}</span>`).join('')
      : '<span class="equip-tag">Bodyweight</span>';

    const tags = document.getElementById('mTags');
    const diffClass = 'diff-' + (ex.difficulty||'');
    tags.innerHTML = `<span class="tag muscle">${cap(ex.muscle||'—')}</span><span class="tag ${diffClass}">${cap(ex.difficulty||'—')}</span>`;

    document.getElementById('modalOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    document.getElementById('modalOverlay').classList.remove('open');
    document.body.style.overflow = '';
  }
  function closeModalOutside(e) { if (e.target === document.getElementById('modalOverlay')) closeModal(); }
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  // ── HELPERS ───────────────────────────────────────────────────
  function cap(s) { return s ? s.replace(/\b\w/g, c => c.toUpperCase()) : ''; }
  function showLoading() {
    document.getElementById('loadingState').style.display = 'flex';
    document.getElementById('exerciseGrid').style.display = 'none';
    document.getElementById('emptyState').style.display = 'none';
    document.getElementById('pagination').innerHTML = '';
    document.querySelectorAll('.error-box').forEach(e=>e.remove());
  }
  function showError(msg) {
    document.getElementById('loadingState').style.display = 'none';
    document.querySelectorAll('.error-box').forEach(e=>e.remove());
    document.getElementById('contentArea').insertAdjacentHTML('afterbegin', `
      <div class="error-box">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <div><p><strong>Error:</strong> ${msg}</p><button class="retry-btn" onclick="loadExercises()">Retry</button></div>
      </div>`);
  }
  function clearSearch() {
    document.getElementById('searchInput').value = '';
    searchQuery = '';
    renderGrid(applyClientFilters());
  }
</script>
</body>
</html>
